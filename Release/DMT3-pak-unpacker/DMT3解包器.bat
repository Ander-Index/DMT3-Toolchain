// DMT3 .pak unpacker - core algorithms
// Ported from unpack_pak.py + lz_code.bin disassembly (Client.exe 0x709EF0 = LZO1X).
// C# 5 compatible (.NET Framework v4.0 csc / PowerShell Add-Type).

// paks can exceed 2GB (movie11 = 2.27GB) which breaks byte[]/File.ReadAllBytes
// on .NET Framework, so pak content is read through a memory-mapped view.
class PakReader : IDisposable
{
    MemoryMappedFile _mmf;
    MemoryMappedViewAccessor _acc;
    public long Length;

    public static PakReader Open(string path)
    {
        PakReader r = new PakReader();
        r._mmf = MemoryMappedFile.CreateFromFile(path, FileMode.Open, null, 0, MemoryMappedFileAccess.Read);
        r._acc = r._mmf.CreateViewAccessor(0, 0, MemoryMappedFileAccess.Read);
        r.Length = new FileInfo(path).Length;
        return r;
    }

    public byte[] ReadBytes(long off, int count)
    {
        if (off + count > Length) count = (int)Math.Max(0, Length - off);
        byte[] b = new byte[count];
        if (count > 0) _acc.ReadArray(off, b, 0, count);
        return b;
    }

    public int Read(long off, byte[] buf, int count)
    {
        if (off + count > Length) count = (int)Math.Max(0, Length - off);
        if (count <= 0) return 0;
        return _acc.ReadArray(off, buf, 0, count);
    }

    public uint ReadU32(long off)
    {
        byte[] b = ReadBytes(off, 4);
        if (b.Length < 4) throw new EndOfStreamException();
        return (uint)(b[0] | (b[1] << 8) | (b[2] << 16) | (b[3] << 24));
    }

    public void Dispose()
    {
        if (_acc != null) _acc.Dispose();
        if (_mmf != null) _mmf.Dispose();
    }
}

static class PakCore
{
    // ---------------------------------------------------------- embedded data

    static byte[] _xortab;
    static Dictionary<string, byte[]> _pakkeys;

    public static byte[] Xortab
    {
        get
        {
            if (_xortab == null)
                _xortab = Convert.FromBase64String(EmbeddedData.XortabB64);
            return _xortab;
        }
    }

    public static byte[] FindPakKey(string baseName, string overrideDir)
    {
        if (overrideDir != null)
        {
            string p = Path.Combine(overrideDir, baseName + ".pak");
            if (File.Exists(p))
            {
                byte[] b = File.ReadAllBytes(p);
                if (b.Length == 128) return b;
            }
        }
        if (_pakkeys == null)
        {
            _pakkeys = new Dictionary<string, byte[]>(StringComparer.OrdinalIgnoreCase);
            foreach (string ln0 in EmbeddedData.PakKeys.Split('\n'))
            {
                string ln = ln0.Trim();
                if (ln.Length == 0) continue;
                int p = ln.IndexOf('|');
                if (p <= 0) continue;
                _pakkeys[ln.Substring(0, p)] = Convert.FromBase64String(ln.Substring(p + 1));
            }
        }
        byte[] k;
        if (_pakkeys.TryGetValue(baseName, out k)) return k;
        return null;
    }

    // ------------------------------------------------------------- keystream
    // Client.exe 0x70a8c0: K(seed,i) = f32bits(sin/cos(f32(seed+i))),
    // 64-bit (SSE2 / ucrt double precision) sin/cos.

    public static uint KsWord(uint seed, long i)
    {
        double x = (float)(double)((ulong)seed + (ulong)i);
        double v = (seed & 1) == 0 ? Math.Sin(x) : Math.Cos(x);
        return BitConverter.ToUInt32(BitConverter.GetBytes((float)v), 0);
    }

    static uint ReadU32(byte[] b, int o)
    {
        return (uint)(b[o] | (b[o + 1] << 8) | (b[o + 2] << 16) | (b[o + 3] << 24));
    }

    static void WriteU32(byte[] b, int o, uint w)
    {
        b[o] = (byte)w;
        b[o + 1] = (byte)(w >> 8);
        b[o + 2] = (byte)(w >> 16);
        b[o + 3] = (byte)(w >> 24);
    }

    // Client.exe 0x70ab60: subtract keystream per dword (allocation-free).
    public static void DecStreamInPlace(byte[] buf, int off, int len, uint seed)
    {
        int nwords = len / 4;
        if (nwords >= 16)
        {
            uint[] words = new uint[nwords];
            Buffer.BlockCopy(buf, off, words, 0, nwords * 4);
            for (int j = 0; j < nwords; j++)
                words[j] = words[j] - KsWord(seed, j);
            Buffer.BlockCopy(words, 0, buf, off, nwords * 4);
        }
        else
        {
            for (int j = 0; j < nwords; j++)
            {
                int o = off + j * 4;
                WriteU32(buf, o, ReadU32(buf, o) - KsWord(seed, j));
            }
        }
    }

    public static byte[] DecStream(byte[] buf, int off, int len, uint seed)
    {
        byte[] b = new byte[len];
        Array.Copy(buf, off, b, 0, len);
        DecStreamInPlace(b, 0, len, seed);
        return b;
    }

    // Client.exe 0x70a620
    public static byte[] XorChain(byte[] buf, int off, int len, bool flag)
    {
        byte[] b = new byte[len];
        Array.Copy(buf, off, b, 0, len);
        if (len < 4) return b;
        uint key = (uint)len ^ 0x18385868u;
        uint old = ReadU32(b, 0);
        uint w = old ^ key;
        WriteU32(b, 0, w);
        key = flag ? w : old;
        int p = 4;
        int cnt = 0;
        while (cnt < ((len - 7) >> 2))
        {
            WriteU32(b, p, ReadU32(b, p) ^ key);
            p += 4;
            cnt += 4;
        }
        return b;
    }

    // ---------------------------------------------------------------- header

    public class HeaderInfo
    {
        public uint Seed;
        public int FirstTable;
        public int Version;
        public int NTables;
        public int FlagByte;
        public int StreamFlag;
        public int Crc;
    }

    public static HeaderInfo ParseHeader(PakReader pr)
    {
        if (pr.Length < 0x31) throw new Exception("文件太小，不是 pak");
        byte[] hb = pr.ReadBytes(0x20, 17);
        uint seed = ReadU32(hb, 0);
        byte[] body = XorChain(DecStream(hb, 4, 13, seed), 0, 13, true);
        HeaderInfo h = new HeaderInfo();
        h.Seed = seed;
        h.FirstTable = (int)ReadU32(body, 0);
        h.Version = body[4];
        h.NTables = (int)ReadU32(body, 6);
        h.FlagByte = body[10];
        h.StreamFlag = body[11];
        h.Crc = body[12];
        return h;
    }

    // ------------------------------------------------------------ descriptors

    public class Entry
    {
        public int Index;
        public string Name;
        public uint Dseed;
        public long Off;
        public long Dlen;
        public long Fsize;
    }

    public class PakEntries
    {
        public List<Entry> Entries = new List<Entry>();
        public string Mode;   // "key" | "cracked" | "subpak"
        public HeaderInfo Header;
    }

    // raw = exactly 0x98 descriptor bytes.
    // keyArr != null -> layer1 byte from key array (raw f1/f2 index).
    // keyByte >= 0 -> layer1 byte override (auto-crack).
    // both null / keyByte<0 -> sub-pak: no XOR layers at all.
    static byte[] DecryptDesc(byte[] raw, byte[] keyArr, int keyByte, int flagByteT)
    {
        byte[] d = new byte[0x98];
        Array.Copy(raw, d, 0x98);
        if (keyArr == null && keyByte < 0) return d;
        int kb;
        if (keyByte >= 0)
        {
            kb = keyByte;
        }
        else
        {
            uint f1 = ReadU32(raw, 4);
            uint f2 = ReadU32(raw, 8);
            long idx = (long)(((ulong)f2 * 0x100000000UL + f1) % 0x7DUL);
            kb = idx < keyArr.Length ? keyArr[idx] : 0;
        }
        for (int o = 0; o < 0x98; o += 4) d[o] ^= (byte)kb;
        uint arg = (uint)flagByteT;
        for (int o = 0; o < 0x98; o += 4)
        {
            d[o] ^= Xortab[arg & 0xFF];
            arg = (arg + 4) & 0xFFFFFFFFu;
        }
        return d;
    }

    static void DecodeDescTail(byte[] desc, Entry e)
    {
        e.Dseed = ReadU32(desc, 0);
        byte[] blob = DecStream(desc, 0x0C, 0x80, e.Dseed);
        int z = 0;
        while (z < blob.Length && blob[z] != 0) z++;
        bool ok = z > 0;
        for (int i = 0; ok && i < z; i++)
            if (blob[i] < 32 || blob[i] >= 127) ok = false;
        e.Name = ok ? Encoding.ASCII.GetString(blob, 0, z) : null;
        e.Dlen = desc[0x8F] | ((long)desc[0x91] << 8) | ((long)desc[0x8D] << 16) | ((long)desc[0x93] << 24);
        e.Fsize = desc[0x92] | ((long)desc[0x8C] << 8) | ((long)desc[0x90] << 16) | ((long)desc[0x8E] << 24);
    }

    // brute-force the layer-1 key byte of one descriptor:
    // decoded filename must be a printable "Resource\..." path and the data
    // region must fit inside the file.
    static List<int> CrackKeyBytes(PakReader pr, long descOff, int flagByteT)
    {
        byte[] raw = pr.ReadBytes(descOff, 0x98);
        if (raw.Length < 0x98) return new List<int>();
        List<int> hits = new List<int>();
        for (int kb = 0; kb < 256; kb++)
        {
            byte[] d = DecryptDesc(raw, null, kb, flagByteT);
            uint dseed = ReadU32(d, 0);
            byte[] head = DecStream(d, 0x0C, 12, dseed);
            if (head[0] != 'R' || head[1] != 'e' || head[2] != 's' || head[3] != 'o' ||
                head[4] != 'u' || head[5] != 'r' || head[6] != 'c' || head[7] != 'e' ||
                head[8] != '\\') continue;
            byte[] blob = DecStream(d, 0x0C, 0x80, dseed);
            int z = 0;
            while (z < blob.Length && blob[z] != 0) z++;
            if (z < 10) continue;
            bool ok = true;
            for (int i = 0; i < z; i++)
                if (blob[i] < 32 || blob[i] >= 127) { ok = false; break; }
            if (!ok) continue;
            long dlen = d[0x8F] | ((long)d[0x91] << 8) | ((long)d[0x8D] << 16) | ((long)d[0x93] << 24);
            if (dlen < 0 || descOff + 0x98 + dlen > pr.Length + 4096) continue;
            hits.Add(kb);
        }
        return hits;
    }

    public static PakEntries ParseEntries(PakReader pr, byte[] keyArr, Action<string> log)
    {
        HeaderInfo info = ParseHeader(pr);
        if (info.Version != 2) throw new Exception("不支持的 pak 版本 " + info.Version);
        PakEntries res = new PakEntries();
        res.Header = info;

        if (keyArr != null)
        {
            res.Mode = "key";
            WalkChain(pr, info, keyArr, -1, res.Entries);
            return res;
        }

        // unknown pak: try to crack descriptor 0 (main pak with unknown key)
        long off = info.FirstTable;
        if (off + 0x98 <= pr.Length)
        {
            List<int> hits = CrackKeyBytes(pr, off, info.FlagByte & 0xFF);
            if (hits.Count >= 1)
            {
                res.Mode = "cracked";
                WalkChainCracked(pr, info, new Dictionary<long, int>(), res.Entries, log);
                return res;
            }
        }

        // sub-pak (%02d.pak style): no XOR layers
        res.Mode = "subpak";
        WalkChain(pr, info, null, -1, res.Entries);
        return res;
    }

    static void WalkChain(PakReader pr, HeaderInfo info, byte[] keyArr, int keyByte, List<Entry> outp)
    {
        long off = info.FirstTable;
        for (int t = 0; t < info.NTables; t++)
        {
            if (off + 0x98 > pr.Length) break;
            byte[] raw = pr.ReadBytes(off, 0x98);
            byte[] desc = DecryptDesc(raw, keyArr, keyByte, (info.FlagByte - t) & 0xFF);
            Entry e = new Entry();
            e.Index = t;
            DecodeDescTail(desc, e);
            if (e.Name == null) e.Name = "_subpak_tbl" + t.ToString("D4") + ".bin";
            e.Off = off + 0x98;
            outp.Add(e);
            off = off + 0x98 + e.Dlen;
        }
    }

    static void WalkChainCracked(PakReader pr, HeaderInfo info, Dictionary<long, int> idxCache,
                                 List<Entry> outp, Action<string> log)
    {
        long off = info.FirstTable;
        for (int t = 0; t < info.NTables; t++)
        {
            if (off + 0x98 > pr.Length) break;
            byte[] raw = pr.ReadBytes(off, 0x98);
            uint f1 = ReadU32(raw, 4);
            uint f2 = ReadU32(raw, 8);
            long idx = (long)(((ulong)f2 * 0x100000000UL + f1) % 0x7DUL);
            int kb;
            if (!idxCache.TryGetValue(idx, out kb))
            {
                List<int> hits = CrackKeyBytes(pr, off, (info.FlagByte - t) & 0xFF);
                if (hits.Count == 1) kb = hits[0];
                else if (hits.Count > 1)
                {
                    kb = hits[0];
                    if (log != null) log("  !! 描述符 " + t + " 密钥候选不唯一，取第一个");
                }
                else
                {
                    kb = -1;
                    if (log != null) log("  !! 描述符 " + t + " 破解失败");
                }
                idxCache[idx] = kb;
            }
            byte[] desc = kb >= 0
                ? DecryptDesc(raw, null, kb, (info.FlagByte - t) & 0xFF)
                : DecryptDesc(raw, null, -1, 0);
            Entry e = new Entry();
            e.Index = t;
            DecodeDescTail(desc, e);
            if (e.Name == null) e.Name = "_subpak_tbl" + t.ToString("D4") + ".bin";
            e.Off = off + 0x98;
            outp.Add(e);
            off = off + 0x98 + e.Dlen;
        }
    }

    // ------------------------------------------------------ LZ (LZO1X) ----
    // Exact port of Client.exe 0x709EF0. Returns bytes written at dst[dstOff..].
    // The game's dword-copy path is byte-identical to forward copying when the
    // match distance >= 4; MatchCopyRun reproduces overlap semantics exactly.
    // Bounds-safe: malformed streams stop early instead of crashing.

    public static int LzDecompress(byte[] src, int srcOff, int srcLen, byte[] dst, int dstOff)
    {
        int ip = srcOff;
        int ipEnd = srcOff + srcLen;
        int op = dstOff;
        int t;
        int mp;

        if (ip >= ipEnd) return 0;
        t = src[ip];
        if (t > 17)
        {
            t -= 17;
            ip++;
            if (t < 4) goto MatchNext;
            if (!LitCopy(src, ref ip, ipEnd, dst, ref op, t)) return op - dstOff;
            goto FirstLiteralRun;
        }

    LoopTop:
        if (ip >= ipEnd) return op - dstOff;
        t = src[ip++];
        if (t >= 16) goto Match;
        if (t == 0)
        {
            while (ip < ipEnd && src[ip] == 0) { t += 255; ip++; }
            if (ip >= ipEnd) return op - dstOff;
            t += 15 + src[ip++];
        }
        if (!LitCopy(src, ref ip, ipEnd, dst, ref op, t + 3)) return op - dstOff;

    FirstLiteralRun:
        if (ip >= ipEnd) return op - dstOff;
        t = src[ip++];
        if (t >= 16) goto Match;
        if (ip >= ipEnd) return op - dstOff;
        mp = op - 0x801 - (t >> 2) - (src[ip++] << 2);
        if (!MatchByte(dst, ref op, mp)) return op - dstOff;
        if (!MatchByte(dst, ref op, mp + 1)) return op - dstOff;
        if (!MatchByte(dst, ref op, mp + 2)) return op - dstOff;
        goto MatchDone;

    Match:
        if (t >= 64)
        {
            if (ip >= ipEnd) return op - dstOff;
            mp = op - 1 - ((t >> 2) & 7) - (src[ip++] << 3);
            t = (t >> 5) - 1;
            MatchCopyRun(dst, ref op, mp, t + 2);
            goto MatchDone;
        }
        if (t >= 32)
        {
            t &= 31;
            if (t == 0)
            {
                while (ip < ipEnd && src[ip] == 0) { t += 255; ip++; }
                if (ip >= ipEnd) return op - dstOff;
                t += 31 + src[ip++];
            }
            if (ip + 2 > ipEnd) return op - dstOff;
            mp = op - 1 - ((src[ip] | (src[ip + 1] << 8)) >> 2);
            ip += 2;
        }
        else if (t >= 16)
        {
            mp = op - ((t & 8) << 11);
            t &= 7;
            if (t == 0)
            {
                while (ip < ipEnd && src[ip] == 0) { t += 255; ip++; }
                if (ip >= ipEnd) return op - dstOff;
                t += 7 + src[ip++];
            }
            if (ip + 2 > ipEnd) return op - dstOff;
            mp -= (src[ip] | (src[ip + 1] << 8)) >> 2;
            ip += 2;
            if (mp == op) return op - dstOff;   // end marker
            mp -= 0x4000;
        }
        else
        {
            if (ip >= ipEnd) return op - dstOff;
            mp = op - 1 - (t >> 2) - (src[ip++] << 2);
            if (!MatchByte(dst, ref op, mp)) return op - dstOff;
            if (!MatchByte(dst, ref op, mp + 1)) return op - dstOff;
            goto MatchDone;
        }
        MatchCopyRun(dst, ref op, mp, t + 2);
        goto MatchDone;

    MatchDone:
        if (ip - 2 < srcOff) return op - dstOff;
        t = src[ip - 2] & 3;
        if (t == 0) goto LoopTop;

    MatchNext:
        if (!LitCopy(src, ref ip, ipEnd, dst, ref op, t)) return op - dstOff;
        if (ip >= ipEnd) return op - dstOff;
        t = src[ip++];
        goto Match;
    }

    static bool LitCopy(byte[] src, ref int ip, int ipEnd, byte[] dst, ref int op, int n)
    {
        if (n <= 0) return true;
        if (ip + n > ipEnd) n = ipEnd - ip;
        if (op + n > dst.Length) n = dst.Length - op;
        if (n <= 0) return false;
        Array.Copy(src, ip, dst, op, n);
        ip += n;
        op += n;
        return true;
    }

    static bool MatchByte(byte[] dst, ref int op, int mp)
    {
        if (op >= dst.Length) return false;
        dst[op++] = (mp >= 0 && mp < dst.Length) ? dst[mp] : (byte)0;
        return true;
    }

    // forward copy of `count` bytes from mp to op; overlap => pattern repeat
    static void MatchCopyRun(byte[] dst, ref int op, int mp, int count)
    {
        if (count <= 0) return;
        int dist = op - mp;
        if (dist <= 0)
        {
            for (int i = 0; i < count && op < dst.Length; i++) dst[op++] = 0;
            return;
        }
        while (count > 0 && op < dst.Length)
        {
            int n = dist < count ? dist : count;
            if (op + n > dst.Length) n = dst.Length - op;
            Array.Copy(dst, mp, dst, op, n);
            op += n;
            mp += n;
            count -= n;
        }
    }

    // ------------------------------------------------------------- extract

    public class ExtractResult
    {
        public int FileCount;
        public int FailCount;
        public List<string> Failures = new List<string>();
        public string Mode;
    }

    public delegate void ProgressFn(int done, int total, string currentName);

    const int ScratchCap = 256 * 1024 * 1024;   // same effective cap as the oracle

    static string SafePath(string baseDir, string resPath)
    {
        string rel = resPath.Replace('\\', '/').TrimStart('/');
        rel = rel.Replace("..", "__");
        return Path.Combine(baseDir, rel.Replace('/', Path.DirectorySeparatorChar));
    }

    // Extract a single entry to an output file stream.
    // Chunks -> LZ -> concat -> truncate to fsize -> mask first 1MB (dseed).
    static void ExtractEntryToFile(PakReader pr, Entry e, string outPath)
    {
        long end = Math.Min(e.Off + e.Dlen, pr.Length);
        long ip = e.Off;
        long fsize = e.Fsize;
        int scratchLen = (int)Math.Min(ScratchCap,
            Math.Max((fsize > 0 ? fsize : 0) * 2 + 65536, 1048576));
        byte[] scratch = new byte[scratchLen];
        byte[] chunk = null;

        string dir = Path.GetDirectoryName(outPath);
        if (dir.Length > 0) Directory.CreateDirectory(dir);

        using (FileStream fs = new FileStream(outPath, FileMode.Create, FileAccess.ReadWrite))
        {
            long written = 0;
            while (ip + 4 <= end)
            {
                uint clen = pr.ReadU32(ip);
                ip += 4;
                if (clen == 0 || clen > end - ip) break;
                if (chunk == null || chunk.Length < (int)clen)
                    chunk = new byte[(int)clen];
                if (pr.Read(ip, chunk, (int)clen) < (int)clen) break;
                int n = LzDecompress(chunk, 0, (int)clen, scratch, 0);
                ip += clen;
                long room = (fsize > 0 ? fsize : long.MaxValue) - written;
                if (room <= 0) break;
                if (n > room) n = (int)room;
                fs.Write(scratch, 0, n);
                written += n;
            }
            long size = fsize > 0 ? Math.Min(fsize, written) : written;
            fs.SetLength(size);
            // mask first min(size, 1MB) with keystream dseed
            int nmask = (int)Math.Min(size, 0xF4240);
            if (nmask > 0)
            {
                byte[] head = new byte[nmask];
                fs.Position = 0;
                int got = 0;
                while (got < nmask)
                {
                    int r = fs.Read(head, got, nmask - got);
                    if (r <= 0) break;
                    got += r;
                }
                DecStreamInPlace(head, 0, got, e.Dseed);
                fs.Position = 0;
                fs.Write(head, 0, got);
            }
        }
    }

    public static ExtractResult ExtractPak(string pakPath, string outRoot, string pakkeyDir,
                                           Action<string> log, ProgressFn progress,
                                           Func<bool> cancelCheck)
    {
        string baseName = Path.GetFileNameWithoutExtension(pakPath);
        byte[] keyArr = FindPakKey(baseName, pakkeyDir);
        ExtractResult res = new ExtractResult();

        using (PakReader pr = PakReader.Open(pakPath))
        {
            PakEntries pe = ParseEntries(pr, keyArr, log);
            res.Mode = pe.Mode;

            string outDir = Path.Combine(outRoot, baseName);
            List<Entry> entries = pe.Entries;
            for (int i = 0; i < entries.Count; i++)
            {
                if (cancelCheck != null && cancelCheck()) break;
                Entry e = entries[i];
                try
                {
                    ExtractEntryToFile(pr, e, SafePath(outDir, e.Name));
                    res.FileCount++;
                }
                catch (Exception ex)
                {
                    res.FailCount++;
                    res.Failures.Add(e.Name + ": " + ex.Message);
                    if (log != null) log("  !! " + e.Name + " -> " + ex.Message);
                }
                if (progress != null) progress(i + 1, entries.Count, e.Name);
            }
        }
        return res;
    }

    // ------------------------------------------------------------ self test

    public static string SelfTest()
    {
        // 1) keystream vectors (generated with validated 64-bit sin/cos)
        foreach (string rec in EmbeddedData.KeystreamVectors.Split(';'))
        {
            string[] p = rec.Split(',');
            uint seed = uint.Parse(p[0]);
            long idx = long.Parse(p[1]);
            uint expect = uint.Parse(p[2]);
            uint got = KsWord(seed, idx);
            if (got != expect)
                return "密钥流自检失败: seed=" + seed + " i=" + idx +
                       " 期望 " + expect + " 实得 " + got +
                       "（本机 Math.Sin/Cos 与游戏 CRT 不一致）";
        }
        // 2) LZ vector: real chunk from CopyRight.pak, sha256 of oracle output
        byte[] chunk = Convert.FromBase64String(EmbeddedData.LzTestChunkB64);
        byte[] dst = new byte[EmbeddedData.LzTestOutLen + 1024];
        int n = LzDecompress(chunk, 0, chunk.Length, dst, 0);
        if (n != EmbeddedData.LzTestOutLen)
            return "LZ 自检失败: 输出长度 " + n + " != " + EmbeddedData.LzTestOutLen;
        var sha = System.Security.Cryptography.SHA256.Create();
        byte[] hash = sha.ComputeHash(dst, 0, n);
        StringBuilder sb = new StringBuilder();
        foreach (byte b in hash) sb.Append(b.ToString("x2"));
        if (sb.ToString() != EmbeddedData.LzTestSha256)
            return "LZ 自检失败: 输出哈希不符";
        return null;   // null = OK
    }
}


// DMT3 .pak unpacker - WinForms GUI (double-click mode)

static class PakGui
{
    public static void Run()
    {
        Application.EnableVisualStyles();
        Application.SetCompatibleTextRenderingDefault(false);
        Application.Run(new MainForm());
    }

    class MainForm : Form
    {
        ListBox lst;
        TextBox txtOut;
        Button btnAddFiles, btnAddDir, btnRemove, btnClear, btnBrowse, btnStart, btnCancel;
        ProgressBar bar;
        Label lblStatus;
        TextBox log;
        BackgroundWorker bw;
        List<string> resultLines;

        public MainForm()
        {
            Text = "DMT3 .pak 解包器";
            Width = 720;
            Height = 560;
            MinimumSize = new Size(560, 460);
            StartPosition = FormStartPosition.Manual;
            var wa = Screen.PrimaryScreen.WorkingArea;
            Location = new Point(wa.Left + Math.Max(0, (wa.Width - Width) / 2),
                                 wa.Top + Math.Max(0, (wa.Height - Height) / 2));
            // show above existing windows once, then drop top-most
            TopMost = true;
            Shown += delegate { TopMost = false; Activate(); };

            var tip = new Label();
            tip.Text = "把 .pak 文件或包含 pak 的文件夹拖进下面列表（也可用按钮添加）：";
            tip.Dock = DockStyle.Top;
            tip.Height = 22;
            tip.Padding = new Padding(6, 4, 0, 0);

            lst = new ListBox();
            lst.Dock = DockStyle.Top;
            lst.Height = 150;
            lst.AllowDrop = true;
            lst.HorizontalScrollbar = true;
            lst.DragEnter += delegate (object s, DragEventArgs e)
            {
                if (e.Data.GetDataPresent(DataFormats.FileDrop))
                    e.Effect = DragDropEffects.Copy;
            };
            lst.DragDrop += delegate (object s, DragEventArgs e)
            {
                string[] files = (string[])e.Data.GetData(DataFormats.FileDrop);
                AddPaths(files);
            };

            var pnlBtns = new FlowLayoutPanel();
            pnlBtns.Dock = DockStyle.Top;
            pnlBtns.Height = 34;
            btnAddFiles = new Button(); btnAddFiles.Text = "添加 pak 文件";
            btnAddDir = new Button(); btnAddDir.Text = "添加文件夹";
            btnRemove = new Button(); btnRemove.Text = "移除选中";
            btnClear = new Button(); btnClear.Text = "清空";
            foreach (Button b in new[] { btnAddFiles, btnAddDir, btnRemove, btnClear })
            {
                b.AutoSize = true;
                pnlBtns.Controls.Add(b);
            }
            btnAddFiles.Click += delegate
            {
                var d = new OpenFileDialog();
                d.Filter = "DMT3 pak 文件 (*.pak)|*.pak|所有文件 (*.*)|*.*";
                d.Multiselect = true;
                if (d.ShowDialog(this) == DialogResult.OK) AddPaths(d.FileNames);
            };
            btnAddDir.Click += delegate
            {
                var d = new FolderBrowserDialog();
                if (d.ShowDialog(this) == DialogResult.OK) AddPaths(new[] { d.SelectedPath });
            };
            btnRemove.Click += delegate
            {
                for (int i = lst.SelectedIndices.Count - 1; i >= 0; i--)
                    lst.Items.RemoveAt(lst.SelectedIndices[i]);
            };
            btnClear.Click += delegate { lst.Items.Clear(); };

            var pnlOut = new Panel();
            pnlOut.Dock = DockStyle.Top;
            pnlOut.Height = 32;
            var lblOut = new Label();
            lblOut.Text = "输出目录:";
            lblOut.AutoSize = true;
            lblOut.Anchor = AnchorStyles.Left;
            txtOut = new TextBox();
            txtOut.Text = "";
            txtOut.Anchor = AnchorStyles.Left | AnchorStyles.Right;
            btnBrowse = new Button(); btnBrowse.Text = "浏览...";
            btnBrowse.AutoSize = true;
            btnBrowse.Anchor = AnchorStyles.Right;
            btnBrowse.Click += delegate
            {
                var d = new FolderBrowserDialog();
                d.SelectedPath = txtOut.Text;
                if (d.ShowDialog(this) == DialogResult.OK) txtOut.Text = d.SelectedPath;
            };
            pnlOut.Controls.Add(lblOut);
            pnlOut.Controls.Add(txtOut);
            pnlOut.Controls.Add(btnBrowse);
            pnlOut.Resize += delegate { LayoutOutPanel(pnlOut, lblOut, txtOut, btnBrowse); };
            LayoutOutPanel(pnlOut, lblOut, txtOut, btnBrowse);

            var pnlRun = new FlowLayoutPanel();
            pnlRun.Dock = DockStyle.Top;
            pnlRun.Height = 36;
            btnStart = new Button(); btnStart.Text = "开始解包"; btnStart.AutoSize = true;
            btnCancel = new Button(); btnCancel.Text = "取消"; btnCancel.AutoSize = true; btnCancel.Enabled = false;
            bar = new ProgressBar(); bar.Width = 300; bar.Height = 22; bar.Margin = new Padding(12, 6, 0, 0);
            pnlRun.Controls.Add(btnStart);
            pnlRun.Controls.Add(btnCancel);
            pnlRun.Controls.Add(bar);

            lblStatus = new Label();
            lblStatus.Dock = DockStyle.Top;
            lblStatus.Height = 20;
            lblStatus.Padding = new Padding(6, 2, 0, 0);

            log = new TextBox();
            log.Multiline = true;
            log.ReadOnly = true;
            log.ScrollBars = ScrollBars.Vertical;
            log.Dock = DockStyle.Fill;
            log.Font = new Font("Consolas", 9f);

            var notice = new Label();
            notice.Text = Program.FreeNotice;
            notice.Dock = DockStyle.Bottom;
            notice.ForeColor = Color.DarkRed;
            notice.Height = 22;
            notice.TextAlign = ContentAlignment.MiddleCenter;

            // dock order: last added with Top docks closest to remaining space edge
            Controls.Add(notice);
            Controls.Add(log);
            Controls.Add(lblStatus);
            Controls.Add(pnlRun);
            Controls.Add(pnlOut);
            Controls.Add(pnlBtns);
            Controls.Add(lst);
            Controls.Add(tip);

            bw = new BackgroundWorker();
            bw.WorkerReportsProgress = true;
            bw.WorkerSupportsCancellation = true;
            bw.DoWork += DoExtract;
            bw.ProgressChanged += delegate (object s, ProgressChangedEventArgs e)
            {
                bar.Value = Math.Min(bar.Maximum, Math.Max(bar.Minimum, e.ProgressPercentage));
                string msg = e.UserState as string;
                if (msg != null) lblStatus.Text = msg;
            };
            bw.RunWorkerCompleted += delegate
            {
                btnStart.Enabled = true;
                btnCancel.Enabled = false;
                foreach (string ln in resultLines) AppendLog(ln);
                AppendLog("—— 结束 ——");
            };

            btnStart.Click += delegate
            {
                if (lst.Items.Count == 0)
                {
                    MessageBox.Show(this, "请先拖入或添加要解包的 pak / 文件夹。", "提示",
                        MessageBoxButtons.OK, MessageBoxIcon.Information);
                    return;
                }
                if (txtOut.Text.Trim().Length == 0)
                {
                    MessageBox.Show(this, "请设置输出目录。", "提示",
                        MessageBoxButtons.OK, MessageBoxIcon.Information);
                    return;
                }
                List<string> inputs = new List<string>();
                foreach (object it in lst.Items) inputs.Add(it.ToString());
                log.Clear();
                lblStatus.Text = "正在扫描...";
                btnStart.Enabled = false;
                btnCancel.Enabled = true;
                resultLines = new List<string>();
                bw.RunWorkerAsync(new object[] { inputs, txtOut.Text.Trim() });
            };
            btnCancel.Click += delegate { bw.CancelAsync(); };
        }

        static void LayoutOutPanel(Panel p, Label l, TextBox t, Button b)
        {
            l.Left = 6; l.Top = 8;
            b.Left = p.Width - b.Width - 8; b.Top = 5;
            t.Left = l.Right + 6; t.Top = 6;
            t.Width = Math.Max(80, b.Left - t.Left - 8);
        }

        void AddPaths(IEnumerable<string> paths)
        {
            foreach (string p in paths)
            {
                if (String.IsNullOrEmpty(p)) continue;
                bool dup = false;
                foreach (object it in lst.Items)
                    if (String.Equals(it.ToString(), p, StringComparison.OrdinalIgnoreCase)) { dup = true; break; }
                if (!dup) lst.Items.Add(p);
            }
        }

        void AppendLog(string s)
        {
            log.AppendText(s + Environment.NewLine);
        }

        void DoExtract(object sender, DoWorkEventArgs e)
        {
            object[] pa = (object[])e.Argument;
            List<string> inputs = (List<string>)pa[0];
            string outDir = (string)pa[1];

            List<string> paks = Program.CollectPaks(inputs);
            if (paks.Count == 0)
            {
                resultLines.Add("没有找到任何 .pak 文件。");
                return;
            }
            Directory.CreateDirectory(outDir);
            resultLines.Add("输出目录: " + outDir);
            resultLines.Add("共 " + paks.Count + " 个 pak");
            var sw = System.Diagnostics.Stopwatch.StartNew();
            int totalFiles = 0, failPaks = 0;
            int pakIdx = 0;
            foreach (string pak in paks)
            {
                if (bw.CancellationPending) { resultLines.Add("已取消。"); break; }
                pakIdx++;
                string baseName = Path.GetFileNameWithoutExtension(pak);
                int curPak = pakIdx;
                try
                {
                    PakCore.ExtractResult r = PakCore.ExtractPak(
                        pak, outDir, null,
                        delegate (string m) { resultLines.Add("  " + baseName + " " + m); },
                        delegate (int done, int total, string cur)
                        {
                            int pct = (int)((pakIdx - 1 + (total > 0 ? (double)done / total : 0)) * 100.0 / paks.Count);
                            bw.ReportProgress(pct,
                                "[" + curPak + "/" + paks.Count + "] " + baseName + ": " + done + "/" + total);
                        },
                        delegate { return bw.CancellationPending; });
                    string mode = r.Mode == "key" ? "" : (r.Mode == "cracked" ? " [自动破解]" : " [子包]");
                    resultLines.Add(baseName + ": " + r.FileCount + " 个文件" +
                                    (r.FailCount > 0 ? ", " + r.FailCount + " 个失败" : " OK") + mode);
                    totalFiles += r.FileCount;
                    if (r.FailCount > 0) failPaks++;
                }
                catch (Exception ex)
                {
                    failPaks++;
                    resultLines.Add(baseName + ": 失败 - " + ex.Message);
                }
                bw.ReportProgress((int)(pakIdx * 100.0 / paks.Count), (string)null);
            }
            resultLines.Add("完成: 共 " + totalFiles + " 个文件, " + failPaks +
                            " 个 pak 有失败, 耗时 " + (sw.ElapsedMilliseconds / 1000) + "s");
            e.Result = null;
        }
    }
}


// DMT3 .pak unpacker - CLI + GUI entry point

public static class Program
{
    [STAThread]
    public static int Main(string[] args)
    {
        // startup self test (keystream + LZ against embedded ground truth)
        string st = PakCore.SelfTest();
        if (st != null)
        {
            Console.WriteLine("[自检失败] " + st);
            if (args.Length == 0)
                System.Windows.Forms.MessageBox.Show(st, "DMT3 解包器 - 自检失败",
                    System.Windows.Forms.MessageBoxButtons.OK,
                    System.Windows.Forms.MessageBoxIcon.Error);
            return 2;
        }

        if (args.Length == 0)
        {
            PakGui.Run();   // double-click mode
            return 0;
        }
        return RunCli(args);
    }

    public const string FreeNotice = "本程序开源、免费。如果您是付费得到这个程序的，请立即退款并举报卖家。";

    static void Usage()
    {
        Console.WriteLine(FreeNotice);
        Console.WriteLine();
        Console.WriteLine("DMT3 .pak 解包器");
        Console.WriteLine("用法: DMT3解包器.bat <pak文件或文件夹...> [-o 输出目录] [--pakkey-dir 密钥目录]");
        Console.WriteLine("  不带参数运行时弹出图形界面。");
        Console.WriteLine("  输出结构: <输出目录>\\<pak名>\\Resource\\...");
    }

    static int RunCli(string[] args)
    {
        List<string> inputs = new List<string>();
        string outDir = null;
        string pakkeyDir = null;
        for (int i = 0; i < args.Length; i++)
        {
            string a = args[i];
            if (a == "-o" || a == "--output")
            {
                if (++i >= args.Length) { Console.WriteLine("!! -o 缺少参数"); return 2; }
                outDir = args[i];
            }
            else if (a == "--pakkey-dir")
            {
                if (++i >= args.Length) { Console.WriteLine("!! --pakkey-dir 缺少参数"); return 2; }
                pakkeyDir = args[i];
            }
            else if (a == "-h" || a == "--help" || a == "/?")
            {
                Usage();
                return 0;
            }
            else
            {
                inputs.Add(a);
            }
        }
        if (inputs.Count == 0) { Usage(); return 2; }
        if (outDir == null) outDir = Path.Combine(Directory.GetCurrentDirectory(), "DMT3_Unpack");

        Console.WriteLine(FreeNotice);
        Console.WriteLine();
        List<string> paks = CollectPaks(inputs);
        if (paks.Count == 0) { Console.WriteLine("!! 没有找到任何 .pak 文件"); return 1; }

        Console.WriteLine("输出目录: " + outDir);
        Console.WriteLine("待解包: " + paks.Count + " 个 pak");
        Directory.CreateDirectory(outDir);

        int totalFiles = 0, failPaks = 0;
        var sw = System.Diagnostics.Stopwatch.StartNew();
        foreach (string pak in paks)
        {
            string baseName = Path.GetFileNameWithoutExtension(pak);
            try
            {
                PakCore.ExtractResult r = PakCore.ExtractPak(
                    pak, outDir, pakkeyDir,
                    delegate (string m) { Console.WriteLine(m); },
                    delegate (int done, int total, string cur)
                    {
                        if (done == total || done % 200 == 0)
                            Console.Write("\r  [" + baseName + "] " + done + "/" + total + "    ");
                    },
                    null);
                Console.WriteLine();
                string mode = r.Mode == "key" ? "" : (r.Mode == "cracked" ? " [自动破解]" : " [子包]");
                if (r.FailCount > 0)
                {
                    failPaks++;
                    Console.WriteLine(baseName + ": " + r.FileCount + " 个文件, " +
                                      r.FailCount + " 个失败" + mode);
                }
                else
                {
                    Console.WriteLine(baseName + ": " + r.FileCount + " 个文件 OK" + mode);
                }
                totalFiles += r.FileCount;
            }
            catch (Exception ex)
            {
                Console.WriteLine();
                failPaks++;
                Console.WriteLine(baseName + ": 失败 - " + ex.ToString());
            }
        }
        Console.WriteLine("完成: 共 " + totalFiles + " 个文件, " + failPaks + " 个 pak 有失败, 耗时 " +
                          (sw.ElapsedMilliseconds / 1000) + "s");
        return failPaks > 0 ? 1 : 0;
    }

    public static List<string> CollectPaks(List<string> inputs)
    {
        List<string> paks = new List<string>();
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (string inp in inputs)
        {
            string s = inp.Trim().Trim('"');
            if (s.Length == 0) continue;
            try
            {
                if (File.Exists(s))
                {
                    if (s.EndsWith(".pak", StringComparison.OrdinalIgnoreCase) && seen.Add(s))
                        paks.Add(s);
                }
                else if (Directory.Exists(s))
                {
                    foreach (string f in Directory.GetFiles(s, "*.pak", SearchOption.AllDirectories))
                        if (seen.Add(f)) paks.Add(f);
                }
                else
                {
                    Console.WriteLine("!! 路径不存在: " + s);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine("!! 无法访问 " + s + ": " + ex.Message);
            }
        }
        paks.Sort(StringComparer.OrdinalIgnoreCase);
        return paks;
    }
}

